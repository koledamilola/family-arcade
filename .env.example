# TEMPLATE ONLY - do not put real keys in this file (it gets uploaded to GitHub).
# Copy this file to ".env.local" and fill in the values from
# Supabase > Project Settings > API Keys (and Data API for the URL).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Keep this one secret! Never share it or put it in game code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional
NEXT_PUBLIC_SITE_NAME=Family Arcade
# Optional but recommended: a long random string (e.g. `openssl rand -base64 32`).
# Kid PINs are mixed with it so they can't be guessed directly against Supabase.
# If unset, the secret key above is used. Changing it later means resetting kids' PINs.
KID_PIN_SECRET=

# Required for AI: encrypts parents' AI keys in the database (any long random string,
# e.g. `openssl rand -base64 32`). Changing it later means parents reconnect their AI.
AI_KEY_SECRET=
